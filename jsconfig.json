{
    "compilerOptions": {
        "baseUrl": ".",
        "paths": {
            "@/*": ["resources/js/*"]
        },
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "jsx": "preserve"
    },
    "include": ["resources/js/**/*.js", "resources/js/**/*.vue"],
    "exclude": ["node_modules", "public"]
}
